{
  "agents": {
    "defaults": {
      "skipBootstrap": true,
      "model": {
        "primary": "github-copilot/gpt-5.4-mini"
      },
      "models": {
        "github-copilot/gpt-5.4-mini": {
          "agentRuntime": {
            "id": "copilot"
          }
        }
      },
      "subagents": {
        "model": "github-copilot/gpt-5.4-mini",
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 3,
        "maxConcurrent": 3,
        "runTimeoutSeconds": 900,
        "archiveAfterMinutes": 60,
        "delegationMode": "prefer"
      }
    }
  },
  "tools": {
    "profile": "coding"
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token"
    }
  },
  "plugins": {
    "entries": {
      "copilot": {
        "enabled": true
      }
    }
  }
}
